{
  "name": "baski-adasi",
  "productName": "Baski Adasi",
  "version": "1.0.0",
  "description": "3D yazıcılar için dinamik ada tarzı masaüstü durum uygulaması (Anycubic LAN + Klipper/Moonraker)",
  "main": "src/main.js",
  "author": "Arpama",
  "license": "MIT",
  "homepage": "https://github.com/Sertacerten06/baski-adasi",
  "repository": { "type": "git", "url": "https://github.com/Sertacerten06/baski-adasi.git" },
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "tr.arpama.baskiadasi",
    "productName": "Baski Adasi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/debug-snap.js",
      "!src/main-manager-ref.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "BaskiAdasi-${version}-kurulum.${ext}"
    },
    "portable": {
      "artifactName": "BaskiAdasi-${version}-tasinabilir.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "BaskiAdasi-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
